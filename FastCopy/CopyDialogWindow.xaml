<essential:WindowEx
    x:Class="FastCopy.CopyDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:local="using:FastCopy"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="RootWindow"
    Closed="WindowEx_Closed"
    ExtendsContentIntoTitleBar="True"
    IsMaximizable="False"
    IsMinimizable="True"
    IsResizable="False"
    mc:Ignorable="d">

    <Grid x:Name="RootPanel">
        <Grid.Resources>
            <essential:ModernStandardWindowContextMenu x:Name="WindowContextMenu" Window="{x:Bind Window}" />
            <local:TaskbarControl
                x:Name="TaskbarControl"
                State="{x:Bind ViewModel.State, Mode=OneWay}"
                Window="{x:Bind Window}"
                Value="{x:Bind ViewModel.Percent, Mode=OneWay}" />

            <Storyboard x:Name="WindowHeightStoryboard">
                <DoubleAnimation
                    x:Name="WindowHeightAnimation"
                    EnableDependentAnimation="True"
                    Storyboard.TargetName="RootWindow"
                    Storyboard.TargetProperty="Height"
                    Duration="0:0:0.5">
                    <DoubleAnimation.EasingFunction>
                        <CircleEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <Storyboard x:Name="WindowRestoreAnimation">
                <DoubleAnimation
                    EnableDependentAnimation="True"
                    Storyboard.TargetName="RootWindow"
                    Storyboard.TargetProperty="Height"
                    Duration="0:0:0.5">
                    <DoubleAnimation.EasingFunction>
                        <CircleEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </Grid.Resources>
        <essential:WindowCaptionButtonThemeWorkaround Window="{x:Bind Window}" />
        <essential:ModernWindowCaptionButtonToolTip Window="{x:Bind Window}" />
        <local:CopyDialog x:Name="CopyDialog" />

        <ScrollViewer x:Name="ErrorScrollViewer" Visibility="Collapsed">
            <ContentPresenter>
                <TextBlock
                    x:Name="ErrorText"
                    Margin="16"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </ContentPresenter>
        </ScrollViewer>
    </Grid>

</essential:WindowEx>
